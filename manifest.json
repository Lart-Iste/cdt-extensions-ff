{
  "manifest_version": 3,
  "name": "Confrérie des Traducteurs - Extensions",
  "version": "1.1.1",
  "description": "Extensions non officielles pour la Confrérie des Traducteurs",
  "icons": {
    "32": "images/logo_32.png",
    "48": "images/logo_48.png",
    "64": "images/logo_64.png",
    "128": "images/logo_128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "images/logo_128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.confrerie-des-traducteurs.fr/*",
    "https://*.confrerie-des-traducteurs.com/*"
  ],
  "background": {
    "scripts": ["background/service-worker.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.nexusmods.com/*/mods/*"
      ],
      "css": [
        "styles/cdtWidget.css"
      ],
      "js": [
        "shared/font.js",
        "shared/settings.js",
        "shared/logger.js",
        "shared/widget.js",
        "scripts/nexusToCdt.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.confrerie-des-traducteurs.fr/*/mods/*"
      ],
      "css": [
        "styles/cdtWidget.css"
      ],
      "js": [
        "shared/font.js",
        "shared/settings.js",
        "shared/logger.js",
        "shared/widget.js",
        "scripts/cdtToMo2.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/logo_32.png",
        "images/logo_48.png",
        "images/logo_64.png",
        "images/logo_128.png",
        "templates/nexusToCdt.html",
        "templates/cdtToMo2.html",
        "fonts/Poppins-Regular.ttf"
      ],
      "matches": [
        "https://www.nexusmods.com/*",
        "https://www.confrerie-des-traducteurs.fr/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cdt-extension@confrerie-des-traducteurs.fr",
    "data_collection_permissions": {
      "required": [
        "none"
      ]
    },
    "strict_min_version": "142.0"
    }
  }
}